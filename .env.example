# Copy to .env for LOCAL runs only (.env is git-ignored). Never commit real values.
# Load into your shell with:  set -a; source .env; set +a

# Alert storage API (your Cloudflare Worker URL, no trailing slash)
ALERTS_API_URL=https://binance-price-alert.your-subdomain.workers.dev
# Must match the Worker secret CHECKER_TOKEN
CHECKER_TOKEN=

# Email delivery (SMTP). Gmail: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
# Optional sender (defaults to SMTP_USERNAME); recipients are comma-separated
EMAIL_FROM=
EMAIL_TO=you@gmail.com

# Optional
MAX_NOTIFICATION_ATTEMPTS=5
# BINANCE_BASE_URLS=https://data-api.binance.vision,https://api.binance.com
